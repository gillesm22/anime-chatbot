# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# hexxii remote (job history + push subscriptions + dev server log)
/.hexxii-remote/
/hexxii-dev.log

# generated review galleries
/regen-gallery.html
/public/regen-gallery.html
/pick-gallery*.html
/selection-gallery.html

# sprite generation working files (candidate batches, never ship)
/public/sprites/*-regen/
/regen-3/
/regen-others/
/merrick-spicy/
/ticia-gen-runs/

# superpowers plugin working state
/.superpowers/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.dev-server.log
